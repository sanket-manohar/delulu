{
  "name": "delulu-check",
  "version": "1.0.0",
  "description": "It's only delulu until it's approved. Pre-submission checks for APK, AAB and IPA: Google Play & App Store upload validation, OWASP MASVS security, privacy drafts and step-by-step release guides. Runs 100% in the browser.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "delulu": "cli/delulu.mjs"
  },
  "files": [
    "cli",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "python3 -m http.server 8080 || npx --yes serve -l 8080 .",
    "test": "node --test tests/*.test.mjs",
    "check": "node --test tests/*.test.mjs && node cli/delulu.mjs --help > /dev/null"
  },
  "keywords": [
    "android",
    "ios",
    "apk",
    "aab",
    "ipa",
    "google-play",
    "app-store",
    "app-review",
    "flutter",
    "react-native",
    "expo",
    "security",
    "owasp",
    "masvs",
    "privacy-manifest",
    "release",
    "mobile"
  ],
  "author": "Sanket Manohar (https://sanketmanohar.com)",
  "homepage": "https://sanket-manohar.github.io/delulu/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanket-manohar/delulu.git"
  },
  "bugs": {
    "url": "https://github.com/sanket-manohar/delulu/issues"
  },
  "funding": "https://github.com/sponsors/sanket-manohar"
}
